    "@thr/pricing": "workspace:*",
    "@thr/shared": "workspace:*",
    "@thr/vendors": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.1",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "pdf-lib": "^1.17.1",
    "pino": "^9.7.0",
