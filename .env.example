# --- Database ---
DATABASE_URL=postgresql://thr:thr@localhost:5432/thr_holidays?schema=public

# --- Redis (optional; in-memory cache is used when unset/unreachable) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production-use-32-plus-chars
JWT_EXPIRES_IN=8h
LOG_LEVEL=info
CANONICAL_CURRENCY=INR
BASE_URL=http://localhost:4000
AGENT_PORTAL_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:3001

# --- Object storage (optional; local filesystem used when unset) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=thr-holidays
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# --- Pricing / quote defaults (also editable in admin System Settings) ---
RATE_LOCK_HOURS=24
TAX_STACKING_ORDER=NET,MARKUP,GST,TCS,COMMISSION
MARKUP_APPROVER_ROLE=REVENUE_ADMIN
WHATSAPP_PROVIDER=stub
TRANSFER_VENDOR=mock-holidaytaxis
ACTIVITY_VENDOR=mock-viator
HOTEL_VENDOR=mock-hotelbeds

# --- SMTP (optional; logs email when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=quotes@thr.com

# --- Frontends ---
NEXT_PUBLIC_API_URL=http://localhost:4000
